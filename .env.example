POSTGRES_DB=shortify
POSTGRES_USER=shortify
# Set a strong password before starting PostgreSQL. Do not commit .env.
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
SERVER_PORT=8080
# Required: generate a random secret of at least 32 UTF-8 bytes. No default is provided.
JWT_SECRET=
JWT_ISSUER=shortify
JWT_EXPIRES_IN=3600
# One exact HTTP(S) frontend origin, without a trailing slash or wildcard.
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Optional: externally reachable origin for returned short URLs.
# SHORTIFY_BASE_URL=http://localhost:8080
