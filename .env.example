POSTGRES_DB=shortify
POSTGRES_USER=shortify
# Set a strong password before starting PostgreSQL. Do not commit .env.
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
SERVER_PORT=8080
FRONTEND_PORT=3000
# Optional Docker build-time browser API origin; defaults to localhost:SERVER_PORT.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Required: generate a random secret of at least 32 UTF-8 bytes. No default is provided.
JWT_SECRET=
JWT_ISSUER=shortify
JWT_EXPIRES_IN=3600
# One exact HTTP(S) frontend origin, without a trailing slash or wildcard.
CORS_ALLOWED_ORIGIN=http://localhost:3000
# Redis is ephemeral and loopback-only in Compose; no authentication is enabled locally.
REDIS_HOST=localhost
REDIS_PORT=6379
# Only set for an externally managed Redis server that requires authentication.
REDIS_PASSWORD=
REDIS_PREFIX=shortify:
# Positive duration, at most 5m. Bounds stale data after an invalidation failure.
CACHE_TTL=30s
RATE_LIMIT_WINDOW=60s
RATE_LIMIT_AUTH=20
RATE_LIMIT_CREATE=60
RATE_LIMIT_REDIRECT=300
# Per-process global redirect budget during Redis outages, using the same window.
RATE_LIMIT_REDIRECT_FALLBACK=100
ANALYTICS_WORKERS=2
ANALYTICS_QUEUE_CAPACITY=1000
# Country/city lookup. Missing providers produce Unknown, without blocking redirects.
GEO_ENABLED=true
# Native backend: readable MaxMind-compatible city MMDB path. Empty disables local lookup.
GEO_DATABASE_PATH=
# Optional Compose override: existing host file mounted by docker-compose.geo.yml.
# GEO_DATABASE_FILE=/absolute/path/to/GeoLite2-City.mmdb
# Optional paid ip-api HTTPS fallback. Keep this server-side; never commit a real key.
GEO_API_KEY=
# Keyless HTTPS fallback (ipwho.is) when no paid key is configured and local data is missing.
# Sends public visitor IPs to that provider; check its usage terms before production use.
# Set false for local-database-only / no keyless external lookup.
GEO_FREE_FALLBACK_ENABLED=true
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For for analytics only.
# Empty means trust only the socket address. Never trust arbitrary public callers.
GEO_TRUSTED_PROXIES=
# Fixed delay in milliseconds; one bounded batch per tick.
CLEANUP_INTERVAL=60000
CLEANUP_BATCH_SIZE=200
# Optional: externally reachable origin for returned short URLs.
# SHORTIFY_BASE_URL=http://localhost:8080
